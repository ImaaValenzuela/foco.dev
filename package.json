{
  "name": "foco.dev",
  "version": "1.0.0",
  "private": true,
  "description": "Workspace de desarrollo para los repositorios de FOCO",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "status": "node scripts/status.mjs",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:landing\" \"npm run dev:app\" \"npm run dev:admin\"",
    "dev:backend": "npm run dev --prefix .workspace/foco.backend",
    "dev:frontend": "npm run dev --prefix .workspace/foco.frontend",
    "dev:landing": "npm run dev --prefix .workspace/foco.landing",
    "dev:app": "npm run start --prefix .workspace/foco.app",
    "dev:admin": "npm run dev --prefix .workspace/foco.admin"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
